# ---- Supabase ----
# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings > API > Project API keys > anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API > service_role key (SERVER ONLY - never expose)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (email notifications) ----
RESEND_API_KEY=
# Must be a verified domain/sender in Resend.
RESEND_FROM_EMAIL=受付Bot <onboarding@resend.dev>

# ---- App ----
# Public base URL used for public URLs, embeds and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe Billing ----
# test or live. Customer/Subscription/Event records are separated by this mode.
STRIPE_MODE=test
# Server only. Never expose this value to the browser.
STRIPE_SECRET_KEY=
# Stripe Dashboard > Developers > Webhooks (or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=
# Optional with the current Hosted Checkout flow. Reserved for future Stripe.js use.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional in local/test use. In live cutover, set this to the dedicated Stripe
# account ID. Readiness then fails closed unless the current key belongs to this
# account and charges, payouts and blocking requirements are all clear.
# Restricted keys used with this gate need permission to read the current account.
STRIPE_EXPECTED_ACCOUNT_ID=
# Optional pre-created Customer Portal configuration. If omitted, the app creates
# or reuses a dedicated configuration from the configured Prices.
STRIPE_PORTAL_CONFIGURATION_ID=
# Recurring monthly Price IDs. Keep all values in the same Stripe mode as the key.
# Current product policy: Light 980 JPY / Standard 1,980 JPY / Pro 3,980 JPY.
STRIPE_PRICE_LIGHT=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
